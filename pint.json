{
    "preset": "laravel",
    "rules": {
        "class_attributes_separation": {
            "elements": {
                "const": "none",
                "property": "none"
            }
        },
        "concat_space": {
            "spacing": "one"
        },
        "increment_style": {
            "style": "pre"
        },
        "new_with_parentheses": {
            "anonymous_class": false,
            "named_class": true
        },
        "no_extra_blank_lines": {
            "tokens": [
                "square_brace_block"
            ]
        },
        "no_whitespace_in_blank_line": true,
        "not_operator_with_successor_space": false,
        "php_unit_attributes": true
    }
}
