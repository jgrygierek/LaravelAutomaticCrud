{
    "name": "jg/laravel-automatic-crud",
    "description": "Convention-based CRUD controllers for Laravel with automatic model, request, resource, and event resolution, pagination, sorting, and searchable filters",
    "type": "library",
    "keywords": [
        "Laravel",
        "crud",
        "controller",
        "automatic"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jarosław Grygierek",
            "email": "jaroslawgrygierek@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3.0",
        "infection/infection": "^0.32.7",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.57",
        "orchestra/testbench": "^10.11|^11.1",
        "phpunit/phpunit": "^13.1.8",
        "rector/rector": "^2.4.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JG\\LaravelAutomaticCrud\\AutomaticCrudServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "JG\\LaravelAutomaticCrud\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JG\\LaravelAutomaticCrud\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "test:feature": "./vendor/bin/phpunit --testsuite Feature",
        "test:unit": "./vendor/bin/phpunit --testsuite Unit",
        "pint": "./vendor/bin/pint",
        "pint:test": "./vendor/bin/pint --test",
        "rector": "./vendor/bin/rector",
        "rector:dry": "./vendor/bin/rector --dry-run",
        "update:l12": "composer update -W --with orchestra/testbench:^10.0",
        "update:l13": "composer update -W --with orchestra/testbench:^11.0",
        "infection": "./vendor/bin/infection --threads=max"
    }
}
